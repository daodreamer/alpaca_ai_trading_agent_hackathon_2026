# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is not,
# so nothing here may ever hold a real value.
#
# Every variable below is read by the code. Nothing that is not read is listed —
# a documented setting that does nothing is worse than an undocumented one,
# because it looks like a lever.

# ---------------------------------------------------------------------- #
# Alpaca — a DEDICATED paper account for this hackathon. Never a live one.
#
# `require_paper_account` refuses to build an MCP transport unless the key
# prefix and the trading URL *both* say paper: keys begin `PK` (live keys begin
# `AK`), and the host must be paper-api. Two independent signals, because
# either one alone can be edited by accident.
#
# `preflight` checks this before every trading day. It is hard gate 4 in
# specs/00-brief.md, and the one rule this project does not negotiate.
# ---------------------------------------------------------------------- #
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# The MCP server reads `ALPACA_API_KEY` / `ALPACA_SECRET_KEY` /
# `ALPACA_PAPER_TRADE` instead. Do not set them here — `mcp_environment()`
# translates the names above into them for the subprocess, so exactly one
# module knows about the discrepancy.

# ---------------------------------------------------------------------- #
# The model. `alphagate.agent` is the only layer allowed to reach one
# (specs/01 Rule 1), and `DeepSeekProposer.from_env` is the only place that
# knows this variable's name — a boundary test enforces that.
#
# Without it the agent REFUSES TO START rather than quietly trading without a
# model. Pass `--no-model` to ask for the deterministic proposer on purpose.
# ---------------------------------------------------------------------- #
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------- #
# Risk limits are NOT configurable by environment, deliberately.
#
# They live in `DEFAULT_LIMITS` (specs/03 D5), typed and tested, where a
# boundary test can see them. An env var that silently widened a limit is
# exactly the bypass specs/01 Rule 2 exists to forbid — and an earlier version
# of this file advertised two such variables that no code ever read, which is
# the failure mode in miniature.
#
# The kill switch is not here either. It latches into `journal/state.json` and
# is cleared by hand, so it survives a restart — an env var would re-arm the
# agent on the next launch, which is the opposite of a latch.
# ---------------------------------------------------------------------- #

# --- Equity execution (specs/09) ---------------------------------------

# The one strategy this account executes. A target book naming any other
# fingerprint is refused by `load_target_book`, which is what makes "only the
# strategy ai_quant_researcher validated" a property rather than a promise.
# Get it from `aqr experiments` or from the target book filename.
ALPHAGATE_STRATEGY_FINGERPRINT=

# Where `aqr target-book` writes. Defaults to
# ai_quant_researcher/runs/target_books relative to the repository root, so this
# only needs setting when the two projects do not sit side by side.
ALPHAGATE_TARGET_BOOKS=
